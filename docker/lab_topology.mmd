  classDef bus fill:#2a2410,stroke:#e8a33d,stroke-width:2px,color:#f3dfb0;
  classDef tap fill:#0f241a,stroke:#46b87a,stroke-width:1px,color:#c9ecd7;
  class CON,CAL,AGT,RTR,FUXA atk;
  class HEAT,CENT,DNP,SENS,HVAC,GAS,WAT,POW,BOIL,SIS tgt;
  class BUS bus;
  class TAP tap;
