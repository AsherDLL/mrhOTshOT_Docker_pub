# Agent (Beta) provider API keys - template.
#
# Copy to docker/agent.env (git-ignored) and fill in the keys you have, then
# bring the console up with the file passed explicitly:
#
#   cp docker/agent.env.example docker/agent.env
#   # edit docker/agent.env, then:
#   docker compose --env-file docker/agent.env -f docker/console.yml up -d
#
# Leave a key blank to disable that provider (the Agent tab marks it "no key").
# NEVER commit docker/agent.env - it is listed in .gitignore.

# OpenAI (api.openai.com)
MRHOTSHOT_OPENAI_KEY=

# Moonshot / Kimi (api.moonshot.ai) - a key from platform.kimi.ai works here; model kimi-k3
MRHOTSHOT_MOONSHOT_KEY=

# Alibaba Qwen (DashScope OpenAI-compatible mode)
MRHOTSHOT_QWEN_KEY=

# OpenRouter (open-source + hosted models behind one key)
MRHOTSHOT_OPENROUTER_KEY=

# Custom OpenAI-compatible endpoint (bring your own). base_url must be https.
MRHOTSHOT_AGENT_BASE_URL=
MRHOTSHOT_AGENT_MODEL=
MRHOTSHOT_AGENT_KEY=
